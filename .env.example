# Feature flag: set to "true" to enable real Bedrock-generated summaries.
# Default is OFF — the app works fully with zero Bedrock access, falling
# back to a deterministic template summary. Every Bedrock call is wrapped
# in try/catch, so a missing model grant or network failure never breaks
# a page even with this flag on.
USE_BEDROCK=false

# Optional overrides (defaults shown)
# BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
# BEDROCK_REGION=ap-south-1
